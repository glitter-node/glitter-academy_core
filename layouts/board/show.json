{
  "version": "1.0.0",
  "layout_name": "board/show",
  "permissions": [],
  "extends": "_user_base",
  "meta": {
    "seo": {
      "enabled": true,
      "extensions": [
        {
          "type": "module",
          "id": "sirsoft-board"
        }
      ],
      "data_sources": [
        "post"
      ],
      "page_type": "post",
      "toggle_setting": "$module_settings:sirsoft-board:seo.seo_post_detail",
      "vars": {
        "site_name": "$core_settings:general.site_name",
        "board_name": "{{post.data.board.name ?? ''}}",
        "post_title": "{{post.data.title ?? ''}}",
        "post_description": "{{post.data.meta_description ?? ''}}"
      },
      "priority": 0.5,
      "changefreq": "monthly",
      "og": {
        "type": "article",
        "title": "{{_seo.post.title ?? post.data.title ?? ''}}",
        "description": "{{_seo.post.description ?? post.data.meta_description ?? post.data.content ?? ''}}",
        "image": "{{post.data.meta_image ?? '/images/og-default.png'}}"
      },
      "structured_data": {
        "@type": "Article",
        "headline": "{{_seo.post.title ?? post.data.title ?? ''}}",
        "description": "{{post.data.meta_description ?? ''}}",
        "image": "{{post.data.meta_image ?? '/images/og-default.png'}}",
        "datePublished": "{{post.data.created_at ?? ''}}",
        "dateModified": "{{post.data.updated_at ?? ''}}"
      }
    }
  },
  "data_sources": [
    {
      "id": "board_access",
      "type": "api",
      "endpoint": "/api/modules/sirsoft-board/boards/{{route.slug}}",
      "method": "GET",
      "params": {
        "include_user_abilities": 1
      },
      "auto_fetch": true,
      "auth_mode": "optional",
      "cache": false,
      "loading_strategy": "progressive",
      "onSuccess": {
        "handler": "conditions",
        "conditions": [
          {
            "if": "{{response.data.data.user_abilities.can_read === true}}",
            "then": {
              "handler": "sequence",
              "actions": [
                {
                  "handler": "setState",
                  "params": {"target": "local", "boardAccess": "allowed", "setupState": "success"}
                },
                {
                  "handler": "refetchDataSource",
                  "params": {"dataSourceId": "post"}
                }
              ]
            }
          },
          {
            "then": {
              "handler": "setState",
              "params": {"target": "local", "boardAccess": "denied"}
            }
          }
        ]
      },
      "errorHandling": {
        "403": {
          "handler": "setState",
          "params": {"target": "local", "boardAccess": "denied"}
        },
        "404": {
          "handler": "conditions",
          "conditions": [
            {"if": "{{_local.setupState === 'already_exists'}}", "then": {"handler": "setState", "params": {"target": "local", "boardAccess": "missing", "setupState": "failed"}}},
            {"then": {"handler": "setState", "params": {"target": "local", "boardAccess": "missing", "setupState": "idle"}}}
          ]
        }
      }
    },
    {
      "id": "post",
      "type": "api",
      "endpoint": "/api/modules/sirsoft-board/boards/{{route.slug}}/posts/{{route.id}}",
      "method": "GET",
      "params": {
        "del_cmt": "{{query.del_cmt ?? ''}}"
      },
      "auto_fetch": false,
      "auth_mode": "optional",
      "refetchOnMount": true,
      "errorHandling": {
        "401": {
          "handler": "sequence",
          "actions": [
            {
              "handler": "toast",
              "params": {
                "type": "info",
                "message": "$t:board.login_required"
              }
            },
            {
              "handler": "navigate",
              "params": {
                "path": "/login"
              }
            }
          ]
        },
        "403": {
          "handler": "setState",
          "params": {"target": "local", "boardAccess": "denied"}
        },
        "404": {
          "handler": "setState",
          "params": {"target": "local", "boardAccess": "missing"}
        }
      },
      "onSuccess": {
        "handler": "refetchDataSource",
        "params": {"dataSourceId": "navigation"}
      }
    },
    {
      "id": "navigation",
      "type": "api",
      "endpoint": "/api/modules/sirsoft-board/boards/{{route.slug}}/posts/{{route.id}}/navigation",
      "method": "GET",
      "params": {
        "del": "{{query.del ?? ''}}"
      },
      "auto_fetch": false,
      "auth_mode": "optional",
      "refetchOnMount": true
    }
  ],
  "init_actions": [
    {
      "handler": "setState",
      "params": {"target": "local", "boardAccess": "checking", "setupState": "idle"}
    }
  ],
  "computed": {
    "commentRootMap": "{{(post?.data?.comments ?? []).reduce((map, c) => ({...map, [c.id]: c.depth === 0 ? c.id : (map[c.parent_id] ?? c.parent_id)}), {})}}"
  },
  "slots": {
    "content": [
      {
        "partial": "partials/board/_access_state.json"
      },
      {
        "if": "{{_local.boardAccess === 'allowed'}}",
        "type": "layout",
        "name": "Container",
        "props": {
          "className": "py-8 max-w-4xl mx-auto"
        },
        "children": [
          {
            "partial": "partials/board/show/_type_renderer.json"
          }
        ]
      }
    ]
  },
  "modals": [
    {
      "if": "{{_local.boardAccess === 'allowed'}}",
      "partial": "partials/board/show/modals/_modal_delete.json"
    },
    {
      "if": "{{_local.boardAccess === 'allowed'}}",
      "partial": "partials/board/show/modals/_modal_report.json"
    },
    {
      "if": "{{_local.boardAccess === 'allowed'}}",
      "partial": "partials/board/show/modals/_password_verify_modal.json"
    }
  ]
}
