{
  "version": "1.0.0",
  "layout_name": "mypage/reservation-detail",
  "extends": "_user_base",
  "permissions": [],
  "computed": {
    "currentTab": "reservations"
  },
  "initLocal": {
    "form": {
      "customer_phone": ""
    },
    "reservations": [],
    "reservation": null,
    "errors": null,
    "isLoading": false,
    "isCancelling": false,
    "lookupFailed": false,
    "cancelFailed": false,
    "cancelSuccess": false,
    "hasSearched": false
  },
  "slots": {
    "content": [
      {
        "type": "basic",
        "name": "Div",
        "props": {
          "className": "min-h-screen bg-slate-50 dark:bg-slate-900"
        },
        "children": [
          {
            "type": "layout",
            "name": "Container",
            "props": {
              "className": "py-8"
            },
            "children": [
              {
                "type": "basic",
                "name": "Div",
                "props": {
                  "className": "flex items-center gap-2 mb-6"
                },
                "children": [
                  {
                    "type": "basic",
                    "name": "Icon",
                    "props": {
                      "name": "calendar",
                      "size": "xl",
                      "className": "text-slate-900 dark:text-white"
                    }
                  },
                  {
                    "type": "basic",
                    "name": "H1",
                    "props": {
                      "className": "text-2xl font-bold text-slate-900 dark:text-white"
                    },
                    "text": "$t:mypage.reservations.detail_title"
                  }
                ]
              },
              {
                "partial": "partials/mypage/_tab_navigation.json"
              },
              {
                "type": "basic",
                "name": "Div",
                "props": {
                  "className": "bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg p-6 mb-6"
                },
                "children": [
                  {
                    "type": "basic",
                    "name": "P",
                    "props": {
                      "className": "text-slate-600 dark:text-slate-300 mb-5"
                    },
                    "text": "$t:mypage.reservations.detail_subtitle"
                  },
                  {
                    "type": "basic",
                    "name": "Form",
                    "dataKey": "form",
                    "props": {
                      "className": "grid grid-cols-1 md:grid-cols-[1fr_auto] gap-3 items-end"
                    },
                    "actions": [
                      {
                        "type": "submit",
                        "handler": "sequence",
                        "actions": [
                          {
                            "handler": "setState",
                            "params": {
                              "target": "local",
                              "isLoading": true,
                              "lookupFailed": false,
                              "cancelFailed": false,
                              "cancelSuccess": false,
                              "errors": null,
                              "hasSearched": false,
                              "reservation": null
                            }
                          },
                          {
                            "handler": "apiCall",
                            "target": "/modules/glitter-reservation/reservation/bookings/lookup?customer_phone={{_local.form.customer_phone ?? ''}}",
                            "params": {
                              "method": "GET"
                            },
                            "onSuccess": [
                              {
                                "handler": "setState",
                                "params": {
                                  "target": "local",
                                  "isLoading": false,
                                  "hasSearched": true,
                                  "reservations": "{{response.data?.data ?? response.data ?? []}}",
                                  "reservation": "{{(response.data?.data ?? response.data ?? []).find(item => String(item.id) === String(route?.id)) ?? null}}"
                                }
                              }
                            ],
                            "onError": [
                              {
                                "handler": "setState",
                                "params": {
                                  "target": "local",
                                  "isLoading": false,
                                  "hasSearched": true,
                                  "lookupFailed": true,
                                  "errors": "{{error.errors}}"
                                }
                              }
                            ]
                          }
                        ]
                      }
                    ],
                    "children": [
                      {
                        "type": "basic",
                        "name": "Div",
                        "children": [
                          {
                            "type": "basic",
                            "name": "Label",
                            "props": {
                              "className": "block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2"
                            },
                            "text": "$t:mypage.reservations.lookup_label"
                          },
                          {
                            "type": "basic",
                            "name": "Input",
                            "props": {
                              "type": "tel",
                              "name": "customer_phone",
                              "placeholder": "$t:mypage.reservations.lookup_placeholder",
                              "className": "w-full px-4 py-3 border border-slate-300 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-700 text-slate-900 dark:text-white",
                              "required": true
                            }
                          }
                        ]
                      },
                      {
                        "type": "basic",
                        "name": "Button",
                        "props": {
                          "type": "submit",
                          "className": "px-4 py-3 bg-emerald-600 text-white rounded-lg hover:bg-emerald-700 transition-colors font-medium disabled:opacity-50",
                          "disabled": "{{_local.isLoading}}"
                        },
                        "text": "{{_local.isLoading ? '$t:mypage.reservations.lookup_processing' : '$t:mypage.reservations.lookup_submit'}}"
                      }
                    ]
                  }
                ]
              },
              {
                "type": "basic",
                "name": "Div",
                "if": "{{_local.lookupFailed}}",
                "props": {
                  "className": "p-4 bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg text-red-800 dark:text-red-200 mb-6"
                },
                "text": "$t:mypage.reservations.lookup_failed"
              },
              {
                "type": "basic",
                "name": "Div",
                "if": "{{_local.cancelFailed}}",
                "props": {
                  "className": "p-4 bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg text-red-800 dark:text-red-200 mb-6"
                },
                "text": "$t:mypage.reservations.cancel_failed"
              },
              {
                "type": "basic",
                "name": "Div",
                "if": "{{_local.cancelSuccess}}",
                "props": {
                  "className": "p-4 bg-emerald-50 dark:bg-emerald-900/20 border border-emerald-200 dark:border-emerald-800 rounded-lg text-emerald-800 dark:text-emerald-200 mb-6"
                },
                "text": "$t:mypage.reservations.cancel_success"
              },
              {
                "type": "basic",
                "name": "Div",
                "if": "{{_local.hasSearched && !_local.reservation && !_local.lookupFailed}}",
                "props": {
                  "className": "p-6 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg text-slate-600 dark:text-slate-300"
                },
                "text": "$t:mypage.reservations.detail_not_found"
              },
              {
                "type": "basic",
                "name": "Div",
                "if": "{{_local.reservation}}",
                "props": {
                  "className": "bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg p-6 space-y-4"
                },
                "children": [
                  {
                    "type": "basic",
                    "name": "H2",
                    "props": {
                      "className": "text-xl font-semibold text-slate-900 dark:text-white"
                    },
                    "text": "{{_local.reservation?.service?.name ?? ''}}"
                  },
                  {
                    "type": "basic",
                    "name": "P",
                    "props": {
                      "className": "text-slate-600 dark:text-slate-300"
                    },
                    "text": "{{_local.reservation?.booking_date ?? ''}} {{_local.reservation?.booking_time ?? ''}}"
                  },
                  {
                    "type": "basic",
                    "name": "P",
                    "props": {
                      "className": "text-slate-600 dark:text-slate-300"
                    },
                    "text": "{{_local.reservation?.status ?? ''}}"
                  },
                  {
                    "type": "basic",
                    "name": "Form",
                    "dataKey": "form",
                    "props": {
                      "className": "pt-4"
                    },
                    "actions": [
                      {
                        "type": "submit",
                        "handler": "sequence",
                        "actions": [
                          {
                            "handler": "setState",
                            "params": {
                              "target": "local",
                              "isCancelling": true,
                              "cancelFailed": false,
                              "cancelSuccess": false,
                              "errors": null
                            }
                          },
                          {
                            "handler": "apiCall",
                            "target": "/modules/glitter-reservation/reservation/bookings/{{route?.id}}/cancel",
                            "params": {
                              "method": "POST",
                              "body": "{{form}}"
                            },
                            "onSuccess": [
                              {
                                "handler": "setState",
                                "params": {
                                  "target": "local",
                                  "isCancelling": false,
                                  "cancelSuccess": true,
                                  "cancelFailed": false
                                }
                              }
                            ],
                            "onError": [
                              {
                                "handler": "setState",
                                "params": {
                                  "target": "local",
                                  "isCancelling": false,
                                  "cancelFailed": true,
                                  "errors": "{{error.errors}}"
                                }
                              }
                            ]
                          }
                        ]
                      }
                    ],
                    "children": [
                      {
                        "type": "basic",
                        "name": "Button",
                        "props": {
                          "type": "submit",
                          "className": "px-4 py-3 bg-red-600 text-white rounded-lg hover:bg-red-700 transition-colors font-medium disabled:opacity-50",
                          "disabled": "{{_local.isCancelling || _local.reservation?.status === 'cancelled' || _local.reservation?.status === 'completed'}}"
                        },
                        "text": "{{_local.isCancelling ? '$t:mypage.reservations.cancel_processing' : '$t:mypage.reservations.cancel_submit'}}"
                      }
                    ]
                  }
                ]
              },
              {
                "type": "basic",
                "name": "Button",
                "props": {
                  "type": "button",
                  "className": "mt-6 px-4 py-2 rounded-lg border border-slate-300 dark:border-slate-600 text-slate-700 dark:text-slate-200 font-medium"
                },
                "text": "$t:mypage.reservations.back_to_list",
                "actions": [
                  {
                    "type": "click",
                    "handler": "navigate",
                    "params": {
                      "path": "/mypage/reservations",
                      "mergeQuery": false
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
