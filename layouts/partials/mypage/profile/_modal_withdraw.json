{
    "meta": {
        "is_partial": true
    },
    "id": "withdrawModal",
    "type": "composite",
    "name": "Modal",
    "props": {
        "title": "$t:mypage.withdraw.modal_title",
        "size": "sm",
        "closeOnBackdropClick": false
    },
    "children": [
        {
            "type": "basic",
            "name": "Div",
            "props": {
                "className": "text-center py-4"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "Div",
                    "props": {
                        "className": "w-16 h-16 mx-auto mb-4 rounded-full bg-red-100 dark:bg-red-900/30 flex items-center justify-center"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Icon",
                            "props": {
                                "name": "triangle-exclamation",
                                "size": "2x",
                                "className": "text-red-600 dark:text-red-400"
                            }
                        }
                    ]
                },
                {
                    "type": "basic",
                    "name": "H3",
                    "props": {
                        "className": "text-lg font-semibold text-slate-900 dark:text-white mb-2"
                    },
                    "text": "$t:mypage.withdraw.confirm_title"
                },
                {
                    "type": "basic",
                    "name": "P",
                    "props": {
                        "className": "text-sm text-slate-600 dark:text-slate-400 mb-4"
                    },
                    "text": "$t:mypage.withdraw.confirm_message"
                },
                {
                    "type": "basic",
                    "name": "Ul",
                    "props": {
                        "className": "text-left text-sm text-slate-600 dark:text-slate-400 bg-slate-50 dark:bg-slate-700/50 rounded-lg p-4 mb-4"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Li",
                            "props": {
                                "className": "flex items-center gap-2 mb-2"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Icon",
                                    "props": {
                                        "name": "x",
                                        "size": "sm",
                                        "className": "text-red-500"
                                    }
                                },
                                {
                                    "type": "basic",
                                    "name": "Span",
                                    "text": "$t:mypage.withdraw.warning_posts"
                                }
                            ]
                        },
                        {
                            "type": "basic",
                            "name": "Li",
                            "props": {
                                "className": "flex items-center gap-2 mb-2"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Icon",
                                    "props": {
                                        "name": "x",
                                        "size": "sm",
                                        "className": "text-red-500"
                                    }
                                },
                                {
                                    "type": "basic",
                                    "name": "Span",
                                    "text": "$t:mypage.withdraw.warning_history"
                                }
                            ]
                        },
                        {
                            "type": "basic",
                            "name": "Li",
                            "props": {
                                "className": "flex items-center gap-2"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Icon",
                                    "props": {
                                        "name": "x",
                                        "size": "sm",
                                        "className": "text-red-500"
                                    }
                                },
                                {
                                    "type": "basic",
                                    "name": "Span",
                                    "text": "$t:mypage.withdraw.warning_points"
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "basic",
                    "name": "Div",
                    "props": {
                        "className": "flex items-center gap-2 mb-4"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Checkbox",
                            "actions": [
                                {
                                    "type": "change",
                                    "handler": "setState",
                                    "params": {
                                        "target": "local",
                                        "form": {
                                            "confirmWithdraw": "{{$event.target.checked}}"
                                        }
                                    }
                                }
                            ],
                            "props": {
                                "name": "confirmWithdraw",
                                "checked": "{{_local.form?.confirmWithdraw ?? false}}"
                            }
                        },
                        {
                            "type": "basic",
                            "name": "Label",
                            "props": {
                                "className": "text-sm text-slate-700 dark:text-slate-300"
                            },
                            "text": "$t:mypage.withdraw.confirm_checkbox"
                        }
                    ]
                },
                {
                    "type": "basic",
                    "name": "Div",
                    "props": {
                        "className": "flex justify-end gap-2 mt-6 pt-4 border-t border-slate-200 dark:border-slate-700"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Button",
                            "actions": [
                                {
                                    "type": "click",
                                    "handler": "closeModal"
                                }
                            ],
                            "props": {
                                "className": "px-4 py-2 border border-slate-300 dark:border-slate-600 text-slate-700 dark:text-slate-300 rounded-lg hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors"
                            },
                            "text": "$t:common.cancel"
                        },
                        {
                            "type": "basic",
                            "name": "Button",
                            "actions": [
                                {
                                    "type": "click",
                                    "handler": "sequence",
                                    "actions": [
                                        {
                                            "handler": "setState",
                                            "params": {
                                                "target": "local",
                                                "isWithdrawing": true
                                            }
                                        },
                                        {
                                            "handler": "apiCall",
                                            "target": "/api/me",
                                            "auth_required": true,
                                            "params": {
                                                "method": "DELETE"
                                            },
                                            "onSuccess": [
                                                {
                                                    "handler": "setState",
                                                    "params": {
                                                        "target": "local",
                                                        "isWithdrawing": false
                                                    }
                                                },
                                                {
                                                    "handler": "closeModal"
                                                },
                                                {
                                                    "handler": "setState",
                                                    "params": {
                                                        "target": "global",
                                                        "currentUser": null,
                                                        "isAuthenticated": false
                                                    }
                                                },
                                                {
                                                    "handler": "toast",
                                                    "params": {
                                                        "type": "success",
                                                        "message": "$t:mypage.withdraw.success"
                                                    }
                                                },
                                                {
                                                    "handler": "navigate",
                                                    "params": {
                                                        "url": "/"
                                                    }
                                                }
                                            ],
                                            "onError": [
                                                {
                                                    "handler": "setState",
                                                    "params": {
                                                        "target": "local",
                                                        "isWithdrawing": false
                                                    }
                                                },
                                                {
                                                    "handler": "toast",
                                                    "params": {
                                                        "type": "error",
                                                        "message": "{{error.message}}"
                                                    }
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ],
                            "props": {
                                "className": "inline-flex items-center justify-center gap-2 px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 disabled:opacity-50 disabled:cursor-not-allowed",
                                "disabled": "{{!_local.form?.confirmWithdraw || _local.isWithdrawing}}"
                            },
                            "children": [
                                {
                                    "type": "basic",
                                    "name": "Icon",
                                    "if": "{{_local.isWithdrawing}}",
                                    "props": {
                                        "name": "spinner",
                                        "size": "sm",
                                        "className": "animate-spin"
                                    }
                                },
                                {
                                    "type": "basic",
                                    "name": "Span",
                                    "text": "$t:mypage.withdraw.confirm_button"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}
