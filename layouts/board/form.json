{
  "version": "1.0.0",
  "layout_name": "board/form",
  "permissions": [],
  "extends": "_user_base",
  "meta": {
    "title": "{{route.id ? '$t:board.edit_post' : '$t:board.new_post'}} - {{form_meta?.data?.board?.name || ''}}"
  },
  "data_sources": [
    {
      "id": "board_access",
      "type": "api",
      "endpoint": "/api/modules/sirsoft-board/boards/{{route.slug}}",
      "method": "GET",
      "auto_fetch": true,
      "auth_mode": "optional",
      "cache": false,
      "loading_strategy": "progressive",
      "params": {
        "include_user_abilities": 1
      },
      "onSuccess": {
        "handler": "conditions",
        "conditions": [
          {
            "if": "{{response.data.data.user_abilities.can_write === true}}",
            "then": {
              "handler": "sequence",
              "actions": [
                {
                  "handler": "setState",
                  "params": {
                    "target": "local",
                    "boardAccess": "allowed",
                    "setupState": "success"
                  }
                },
                {
                  "handler": "refetchDataSource",
                  "params": {
                    "dataSourceId": "form_data"
                  }
                }
              ]
            }
          },
          {
            "then": {
              "handler": "setState",
              "params": {
                "target": "local",
                "boardAccess": "denied"
              }
            }
          }
        ]
      },
      "errorHandling": {
        "403": {
          "handler": "setState",
          "params": {
            "target": "local",
            "boardAccess": "denied"
          }
        },
        "404": {
          "handler": "conditions",
          "conditions": [
            {"if": "{{_local.setupState === 'already_exists'}}", "then": {"handler": "setState", "params": {"target": "local", "boardAccess": "missing", "setupState": "failed"}}},
            {"then": {"handler": "setState", "params": {"target": "local", "boardAccess": "missing", "setupState": "idle"}}}
          ]
        }
      }
    },
    {
      "id": "form_data",
      "type": "api",
      "endpoint": "/api/modules/sirsoft-board/boards/{{route.slug}}/posts/form-data",
      "method": "GET",
      "auto_fetch": false,
      "auth_mode": "optional",
      "cache": false,
      "refetchOnMount": true,
      "initLocal": "form",
      "loading_strategy": "blocking",
      "params": {
        "post_id": "{{route?.id ?? ''}}",
        "parent_id": "{{query?.parent_id ?? ''}}",
        "verification_token": "{{_local.verificationToken ?? ''}}"
      },
      "onSuccess": {
        "handler": "sequence",
        "actions": [
          {
            "handler": "setState",
            "params": {
              "target": "local",
              "form": "{{response.data.data}}"
            }
          },
          {
            "handler": "refetchDataSource",
            "params": {
              "dataSourceId": "form_meta"
            }
          }
        ]
      },
      "errorHandling": {
        "401": {
          "handler": "sequence",
          "actions": [
            {
              "handler": "toast",
              "params": {
                "type": "info",
                "message": "$t:board.login_required_to_write"
              }
            },
            {
              "handler": "navigate",
              "params": {
                "path": "/login",
                "query": {
                  "redirect": "/board/{{route.slug}}/write"
                }
              }
            }
          ]
        },
        "403": {
          "handler": "setState",
          "params": {
            "target": "local",
            "boardAccess": "denied"
          }
        },
        "404": {
          "handler": "setState",
          "params": {
            "target": "local",
            "boardAccess": "missing"
          }
        }
      }
    },
    {
      "id": "form_meta",
      "type": "api",
      "endpoint": "/api/modules/sirsoft-board/boards/{{route.slug}}/posts/form-meta",
      "method": "GET",
      "auto_fetch": false,
      "auth_mode": "optional",
      "cache": false,
      "refetchOnMount": true,
      "params": {
        "post_id": "{{route?.id ?? ''}}",
        "parent_id": "{{query?.parent_id ?? ''}}",
        "verification_token": "{{_local.verificationToken ?? ''}}"
      },
      "errorHandling": {
        "401": {
          "handler": "sequence",
          "actions": [
            {
              "handler": "toast",
              "params": {
                "type": "info",
                "message": "$t:board.login_required_to_write"
              }
            },
            {
              "handler": "navigate",
              "params": {
                "path": "/login",
                "query": {
                  "redirect": "/board/{{route.slug}}/write"
                }
              }
            }
          ]
        },
        "403": {
          "handler": "setState",
          "params": {
            "target": "local",
            "boardAccess": "denied"
          }
        },
        "404": {
          "handler": "setState",
          "params": {
            "target": "local",
            "boardAccess": "missing"
          }
        }
      }
    }
  ],
  "init_actions": [
    {
      "handler": "setState",
      "params": {
        "target": "local",
        "boardAccess": "checking",
        "setupState": "idle",
        "tempKey": "{{('temp_' + Date.now() + '_' + Math.random().toString(36).substr(2, 9))}}"
      }
    }
  ],
  "slots": {
    "content": [
      {
        "if": "{{_local.boardAccess === 'allowed'}}",
        "partial": "partials/board/form/_password_verify_modal.json"
      },
      {
        "partial": "partials/board/_access_state.json"
      },
      {
        "if": "{{_local.boardAccess === 'allowed'}}",
        "type": "layout",
        "name": "Container",
        "blur_until_loaded": {
          "enabled": true,
          "data_sources": [
            "form_data"
          ]
        },
        "dataKey": "form",
        "trackChanges": true,
        "props": {
          "className": "py-8 max-w-4xl mx-auto"
        },
        "children": [
          {
            "partial": "partials/board/form/_type_renderer.json"
          }
        ]
      }
    ]
  }
}
