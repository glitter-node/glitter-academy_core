{
  "version": "1.0.0",
  "layout_name": "board/index",
  "permissions": [],
  "extends": "_user_base",
  "meta": {
    "seo": {
      "enabled": true,
      "extensions": [
        {
          "type": "module",
          "id": "sirsoft-board"
        }
      ],
      "data_sources": [
        "posts"
      ],
      "page_type": "board",
      "toggle_setting": "$module_settings:sirsoft-board:seo.seo_board",
      "vars": {
        "site_name": "$core_settings:general.site_name",
        "board_name": "{{posts.data.board.name ?? ''}}",
        "board_description": "{{posts.data.board.description ?? ''}}"
      },
      "priority": 0.6,
      "changefreq": "daily",
      "og": {
        "type": "website",
        "title": "{{posts.data.meta_title ?? _seo.board.title ?? posts.data.board.name ?? ''}}",
        "description": "{{_seo.board.description ?? posts.data.board.description ?? ''}}",
        "image": "/images/og-default.png"
      },
      "structured_data": {
        "@type": "ItemList"
      }
    }
  },
  "data_sources": [
    {
      "id": "board_access",
      "type": "api",
      "endpoint": "/api/modules/sirsoft-board/boards/{{route.slug}}",
      "method": "GET",
      "params": {
        "include_user_abilities": 1
      },
      "auto_fetch": true,
      "auth_mode": "optional",
      "cache": false,
      "loading_strategy": "progressive",
      "onSuccess": {
        "handler": "conditions",
        "conditions": [
          {
            "if": "{{response.data.data.user_abilities.can_read === true}}",
            "then": {
              "handler": "sequence",
              "actions": [
                {
                  "handler": "setState",
                  "params": {"target": "local", "boardAccess": "allowed", "setupState": "success"}
                },
                {
                  "handler": "refetchDataSource",
                  "params": {"dataSourceId": "posts"}
                }
              ]
            }
          },
          {
            "then": {
              "handler": "setState",
              "params": {"target": "local", "boardAccess": "denied"}
            }
          }
        ]
      },
      "errorHandling": {
        "403": {
          "handler": "setState",
          "params": {"target": "local", "boardAccess": "denied"}
        },
        "404": {
          "handler": "conditions",
          "conditions": [
            {"if": "{{_local.setupState === 'already_exists'}}", "then": {"handler": "setState", "params": {"target": "local", "boardAccess": "missing", "setupState": "failed"}}},
            {"then": {"handler": "setState", "params": {"target": "local", "boardAccess": "missing", "setupState": "idle"}}}
          ]
        }
      }
    },
    {
      "id": "posts",
      "type": "api",
      "endpoint": "/api/modules/sirsoft-board/boards/{{route.slug}}/posts",
      "method": "GET",
      "params": {
        "page": "{{query.page ?? 1}}",
        "search": "{{query.search ?? ''}}",
        "category": "{{query.category ?? ''}}",
        "filters[0][field]": "{{query['filters[0][field]'] ?? ''}}",
        "filters[0][value]": "{{query['filters[0][value]'] ?? ''}}",
        "filters[0][operator]": "{{query['filters[0][operator]'] ?? ''}}",
        "del": "{{query.del ?? ''}}"
      },
      "auto_fetch": false,
      "auth_mode": "optional",
      "refetchOnMount": true,
      "errorHandling": {
        "401": {
          "handler": "sequence",
          "actions": [
            {
              "handler": "toast",
              "params": {
                "type": "info",
                "message": "$t:board.login_required"
              }
            },
            {
              "handler": "navigate",
              "params": {
                "path": "/login"
              }
            }
          ]
        },
        "403": {
          "handler": "setState",
          "params": {"target": "local", "boardAccess": "denied"}
        },
        "404": {
          "handler": "setState",
          "params": {"target": "local", "boardAccess": "missing"}
        }
      },
      "onError": {
        "handler": "setState",
        "params": {
          "target": "global",
          "hasError": true
        }
      }
    }
  ],
  "init_actions": [
    {
      "handler": "setState",
      "params": {"target": "local", "boardAccess": "checking", "setupState": "idle"}
    }
  ],
  "slots": {
    "content": [
      {
        "partial": "partials/board/_access_state.json"
      },
      {
        "if": "{{_local.boardAccess === 'allowed'}}",
        "partial": "partials/board/index/_loading_error.json"
      },
      {
        "type": "layout",
        "name": "Container",
        "if": "{{_local.boardAccess === 'allowed' && posts?.data?.board}}",
        "props": {
          "className": "py-8"
        },
        "children": [
          {
            "partial": "partials/board/index/_type_renderer.json"
          }
        ]
      }
    ]
  }
}
